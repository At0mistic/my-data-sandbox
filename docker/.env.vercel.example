# Vercel PostgreSQL Database Credentials
# Copy this file to .env.vercel and fill in your actual Vercel database credentials
# These will be used by Airflow to connect to Vercel DB for ingestion

VERCEL_POSTGRES_HOST=ep-xxx.region.postgres.vercel-storage.com
VERCEL_POSTGRES_PORT=5432
VERCEL_POSTGRES_USER=default
VERCEL_POSTGRES_PASSWORD=xxxxx
VERCEL_POSTGRES_DB=verceldb
